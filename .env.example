# Resend Email API Key
RESEND_API_KEY=

# E-postadressen som ska ta emot leads (t.ex. säljare eller admin)
ADMIN_EMAIL=

# KV_REST_API_URL och KV_REST_API_TOKEN skapas automatiskt av Vercel
# när en Redis-databas kopplas till projektet via Storage-fliken i Vercel Dashboard.
# Behöver INTE fyllas i manuellt vid lokal utveckling om du kör `vercel env pull`.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Tillåten origin (t.ex. https://www.dittforetag.se) - Lämna tom lokalt
ALLOWED_ORIGIN=
